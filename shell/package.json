{
  "name": "retron-shell",
  "productName": "Retron",
  "version": "1.0.0",
  "private": true,
  "description": "Retron 桌面外壳（后台静默启动本地引擎 + 提供应用窗口）",
  "main": "main.js",
  "author": "zzl",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "local.retron.desktop",
    "productName": "Retron",
    "directories": {
      "output": "../Retron-dist"
    },
    "files": [
      "main.js",
      "loading.html",
      "icon.ico"
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": "dir",
      "icon": "icon.ico"
    }
  }
}
